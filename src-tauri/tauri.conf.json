{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yupic",
  "version": "0.1.2",
  "identifier": "com.yujin.yupic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yupic",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "tiff",
          "tif",
          "heic",
          "heif",
          "avif",
          "jxl",
          "arw",
          "raw",
          "sr2",
          "cr2",
          "nef",
          "dng",
          "orf",
          "rw2",
          "pef",
          "raf"
        ],
        "name": "Image",
        "role": "Viewer"
      }
    ]
  }
}